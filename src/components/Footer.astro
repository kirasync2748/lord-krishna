---
import { shukaSharira } from "../data/content";
---
<footer>
  <div class="footer-ornament">॥ হরে কৃষ্ণ ॥</div>
  <p>শ্রীশ্রীকৃষ্ণের অষ্টোত্তর শতনাম ও চৌত্রিশ পদাবলী</p>
  <p class="sub">ভক্তিভাবে সমর্পিত ॥ জয় শ্রীকৃষ্ণ ॥</p>
</footer>

<style>
  footer {
    text-align: center;
    padding: 3.5rem 1.5rem;
    background: linear-gradient(180deg, var(--maroon-dark), #2a0e05);
    color: rgba(254, 249, 240, 0.8);
  }

  .footer-ornament {
    font-size: 1.4rem;
    color: var(--gold-light);
    margin-bottom: 1rem;
    letter-spacing: 0.1em;
  }

  p {
    font-size: 1rem;
    line-height: 1.6;
  }

  .sub {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    opacity: 0.7;
    font-style: italic;
  }
</style>
