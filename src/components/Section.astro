---
export interface Props {
  id: string;
  title: string;
  subtitle?: string;
  ornament?: string;
}
const { id, title, subtitle, ornament = "❁" } = Astro.props;
---
<section id={id} class="section">
  <div class="section-header">
    <span class="ornament">{ornament}</span>
    <h2>{title}</h2>
    {subtitle && <p class="subtitle">{subtitle}</p>}
  </div>
  <div class="section-body">
    <slot />
  </div>
</section>

<style>
  .section {
    max-width: 860px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 4.5rem;
    position: relative;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .ornament {
    font-size: 1.8rem;
    color: var(--gold);
    display: block;
    margin-bottom: 0.3rem;
    text-shadow: 0 0 12px rgba(212, 160, 23, 0.4);
  }

  h2 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 700;
    color: var(--maroon);
    line-height: 1.4;
    position: relative;
    display: inline-block;
    padding: 0 1.5rem;
  }

  h2::before,
  h2::after {
    content: "॥";
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gold);
    font-size: 0.8em;
    opacity: 0.6;
  }
  h2::before { left: -0.2rem; }
  h2::after { right: -0.2rem; }

  .subtitle {
    margin-top: 0.75rem;
    color: var(--saffron-dark);
    font-size: 1rem;
    font-style: italic;
    opacity: 0.85;
  }

  .section-body {
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(212, 160, 23, 0.3);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    box-shadow:
      0 4px 24px rgba(124, 45, 18, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(4px);
  }

  @media (max-width: 600px) {
    .section { padding: 2.5rem 0.75rem 3rem; }
    .section-body { padding: 1.5rem 1rem; }
    h2::before, h2::after { display: none; }
  }
</style>
